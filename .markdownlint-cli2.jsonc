{
  // markdownlint-cli2 configuration.
  //
  // `default` keeps the full rule set on. The rules disabled below are style
  // preferences that the project's existing (pre-documentation-sweep) files
  // already use different conventions for; keeping them off lets the shared
  // lint check stay green without rewriting existing, curated content. The
  // structural rules (duplicate headings, code-span spacing, etc.) stay on for
  // the documentation under docs/ and .github/.
  "config": {
    "default": true,
    "MD001": false,
    "MD004": false,
    "MD005": false,
    "MD007": false,
    "MD012": false,
    "MD013": false,
    "MD022": false,
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD026": false,
    "MD028": false,
    "MD030": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD042": false,
    "MD046": "fenced",
    "MD047": false,
    "MD048": false,
    "MD051": false
  }
}
